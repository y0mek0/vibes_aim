# aim2stock — gitignore

# Node / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# Local server caches
.valotrainer_upstream/
.upstream/
.cache/
.parcel-cache/
.vite/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Env files (never commit API keys)
.env
.env.local
.env.*.local

# Logs
*.log

# Build outputs
dist/
build/
out/
# Local Python artefacts
__pycache__/
*.pyc
*.pyo
.local-installers/
