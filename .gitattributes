* text=auto

# Force LF for source files; CRLF warnings are noise in this repo.
*.js        eol=lf
*.mjs       eol=lf
*.json      eol=lf
*.css       eol=lf
*.html      eol=lf
*.md        eol=lf
*.yml       eol=lf
*.yaml      eol=lf
*.sql       eol=lf
*.py        eol=lf
*.sh        eol=lf

# Generated third-party SDK bundle retains legal ASCII-art whitespace.
client/js/privy-wallet.bundle.js -whitespace

# Binary assets (keep gitattributes sane for them).
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
