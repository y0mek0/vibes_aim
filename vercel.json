{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "client/**",
      "use": "@vercel/static",
      "config": {
        "exclude": [
          "server/**",
          "tests/**",
          "docs/**",
          "tools/**",
          "deploy/**",
          "design-system/**",
          "node_modules/**",
          "*.mjs",
          "*.md",
          ".env*",
          "package.json",
          "package-lock.json",
          "vercel.json"
        ]
      }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 25
      }
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/client/index.html" },
    { "source": "/css/:path*", "destination": "/client/css/:path*" },
    { "source": "/js/:path*", "destination": "/client/js/:path*" },
    { "source": "/src/:path*", "destination": "/client/src/:path*" },
    { "source": "/img/:path*", "destination": "/client/img/:path*" },
    { "source": "/vendor/:path*", "destination": "/client/vendor/:path*" },
    { "source": "/favicon.svg", "destination": "/client/favicon.svg" },
    { "source": "/favicon.ico", "destination": "/client/favicon.ico" },
    { "source": "/sw.js", "destination": "/client/sw.js" },
    { "source": "/manifest.json", "destination": "/client/manifest.json" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/auth/:path*", "destination": "/api/index.js" },
    { "source": "/portfolio/:path*", "destination": "/api/index.js" },
    { "source": "/aim/:path*", "destination": "/api/index.js" },
    { "source": "/missions/:path*", "destination": "/api/index.js" },
    { "source": "/loadout/:path*", "destination": "/api/index.js" },
    { "source": "/market/:path*", "destination": "/api/index.js" }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/client/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/client/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}