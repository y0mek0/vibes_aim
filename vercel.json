{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "client/**",
      "use": "@vercel/static",
      "config": {
        "exclude": [
          "server/**",
          "tests/**",
          "docs/**",
          "tools/**",
          "deploy/**",
          "design-system/**",
          "node_modules/**",
          "*.mjs",
          "*.md",
          ".env*",
          "package.json",
          "package-lock.json",
          "vercel.json"
        ]
      }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 25
      }
    }
  ],
  "rewrites": [
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/auth/:path*", "destination": "/api/index.js" },
    { "source": "/portfolio/:path*", "destination": "/api/index.js" },
    { "source": "/aim/:path*", "destination": "/api/index.js" },
    { "source": "/missions/:path*", "destination": "/api/index.js" },
    { "source": "/loadout/:path*", "destination": "/api/index.js" },
    { "source": "/market/:path*", "destination": "/api/index.js" }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}